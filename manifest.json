{
  "system": "Wix",
  "additional_parameters": {
    "token_url": {}
  },
  "auth": "oauth2",
  "oauth2": {
    "login_url": "https://www.wix.com/installer/install",
    "scopes": [
      "SCOPE.DC.MANAGE-YOUR-APP",
      "SCOPE.HEADLESS.MANAGE",
      "SCOPE.DC-CONTACTS-MEGA.MANAGE-MEMBERS-CONTACTS",
      "SCOPE.STORES.INVENTORY_ITEM_WRITE",
      "SCOPE.STORES.INVENTORY_ITEM_READ",
      "SCOPE.DC-MEMBERS.MANAGE-MEMBERS",
      "SCOPE.DC-PAIDPLANS.MANAGE-ORDERS",
      "SCOPE.DC-RESTAURANTS.MANAGE-ORDERS",
      "SCOPE.DC-EVENTS.MANAGE-ORDERS",
      "SCOPE.DC-STORES.MANAGE-ORDERS",
      "SCOPE.DC-STORES.MANAGE-PRODUCTS",
      "SCOPE.DC-CURRENCY-CONVERTER.MANAGE-CURRENCIES"
    ],
    "token_url": "https://www.wix.com/oauth/access"
  },
  "datatypes": {
    "contacts": {
      "template": "templates/contacts.json"
    },
    "inventory": {
      "parameters": {
        "payload_property": "inventoryItem"
      },
      "template": "templates/products.json"
    },
    "members": {
      "template": "templates/contacts.json"
    },
    "orders": {
      "parameters": {
        "payload_property": "order"
      },
      "template": "templates/products.json"
    },
    "products": {
      "parameters": {
        "payload_property": "product"
      },
      "template": "templates/products.json"
    },
    "currencies": {
      "template": "templates/contacts.json"
    }
  },
  "system-template": "templates/system.json"
}